# =============================================================
# Nuclear Outage Prediction Pipeline — API Keys
# =============================================================
# Copy this file to configs/.env and fill in your keys.
#
# How to get each key (all free):
#   EIA:      https://www.eia.gov/opendata/
#   NOAA CDO: https://www.ncdc.noaa.gov/cdo-web/token
#   PJM:      https://accountmanager.pjm.com/ → https://apiportal.pjm.com/
# =============================================================

# EIA Open Data API v2 (free, instant)
EIA_API_KEY=PASTE_YOUR_EIA_KEY_HERE

# NOAA Climate Data Online API (free, emailed instantly)
NOAA_CDO_TOKEN=PASTE_YOUR_NOAA_CDO_TOKEN_HERE

# PJM Data Miner 2 (free registration required)
PJM_API_KEY=PASTE_YOUR_PJM_SUBSCRIPTION_KEY_HERE

# SEC EDGAR (no key needed — just a contact email for User-Agent)
SEC_CONTACT_EMAIL=your.email@example.com

# NOAA NWS (no key needed — just a contact identifier for User-Agent)
NWS_USER_AGENT=(nuclear-outage-research, your.email@example.com)
